POSTGRES_DB=chatbot_vectors
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambiar
POSTGRES_PORT=5432


LLM_API_KEY=
# Embeddings (HU-33): openai u ollama. Si EMBEDDING_API_KEY queda vacía se usa LLM_API_KEY
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Debe coincidir con el modelo de embeddings (text-embedding-3-small = 1536, nomic-embed-text = 768)
EMBEDDING_DIMENSION=1536
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/chatbot_vectors
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=chatbot-interacciones

LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-5-mini
